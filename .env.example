# Copy to .env and fill in. .env is gitignored.

# HuggingFace Inference API token — used by src/llm.py for Qwen2.5-7B-Instruct.
# Create one at https://huggingface.co/settings/tokens (a "Read" token is enough).
HF_TOKEN=

# Kaggle credentials — only needed by scripts/build_db.py when downloading
# TheLook CSVs. Not needed if you pass --csv-dir with CSVs you already have.
# Create at https://www.kaggle.com/settings/account -> "Create New Token"
KAGGLE_USERNAME=
KAGGLE_KEY=
